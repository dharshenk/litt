# Local Node server
PORT=8787
# Use the https:// origin in production (terminate TLS in a reverse proxy)
PUBLIC_BASE_URL=http://localhost:8787
DATABASE_PATH=./litt.db
NODE_ENV=development

# Discord / Google OAuth: leave all blank to use local dev identities
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Google OAuth (optional, can be used alongside Discord).
# Authorized redirect URI: ${PUBLIC_BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Enable only for local end-to-end tests; ignored unless NODE_ENV=development
LITT_DEV_TOOLS=0
