# Local Node server
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DATABASE_PATH=./litt.db
NODE_ENV=development

# Discord / Google OAuth: leave all blank to use local dev identities
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Google OAuth (optional, can be used alongside Discord).
# Authorized redirect URI: ${PUBLIC_BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Enable only for local end-to-end tests; ignored in production
LITT_DEV_TOOLS=0
