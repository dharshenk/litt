# Local Node server
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DATABASE_PATH=./litt.db
NODE_ENV=development

# Discord OAuth: leave blank to use local dev identities
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=

# Enable only for local end-to-end tests; ignored in production
LITT_DEV_TOOLS=0